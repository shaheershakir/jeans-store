# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Persistence (Neon PostgreSQL)
# Local development & Test deployment (Neon 'test' branch):
# DATABASE_URL=postgresql://[user]:[password]@[test-endpoint].neon.tech/search?sslmode=require
# Production deployment (Neon 'main' branch):
# DATABASE_URL=postgresql://[user]:[password]@[production-endpoint].neon.tech/search?sslmode=require
# NOTE: Never expose DATABASE_URL to frontend or client-side bundles.
DATABASE_URL=

# Security & Authentication
# Secret key required to access POST, PUT, DELETE /api/products and /api/orders
ADMIN_API_KEY=your_secure_admin_api_key_here

# Frontend ISR Revalidation
# URL of storefront (e.g. https://storefront-xxx-uc.a.run.app)
FRONTEND_URL=http://localhost:3000
# Shared secret matching frontend's REVALIDATION_SECRET
REVALIDATION_SECRET=your_revalidation_secret_here
