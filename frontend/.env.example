# Build-time API for static product catalog generation
BACKEND_URL=http://localhost:4000

# WhatsApp concierge order handoff (format: country code + number, e.g. 919876543210)
# If left unset or empty, checkout falls back to mailto:orders@infit.in
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Frontend monitoring via Sentry (no-op if unset)
NEXT_PUBLIC_SENTRY_DSN=

# Canonical storefront domain
NEXT_PUBLIC_SITE_URL=https://infit.in
