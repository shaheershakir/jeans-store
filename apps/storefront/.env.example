# Storefront Environment Configuration
# Express API URL (e.g. https://api-xxx-uc.a.run.app or http://localhost:4000)
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:4000/assets

# WhatsApp Order Concierge Phone Number (with country code, digits only, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# On-Demand ISR Revalidation Secret (shared with backend)
REVALIDATION_SECRET=your_revalidation_secret_here

# Sentry Exception Monitoring DSN (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Production Site URL
NEXT_PUBLIC_SITE_URL=https://teesgarage.in

# Google OAuth 2.0 Client ID (Public web client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay Checkout Key ID (Public key ID, e.g. rzp_test_... or rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# PostHog Product Analytics (US Cloud with Next.js /ingest proxy)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest
