{
  "name": "@jeans-store/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:backfill-orders": "tsx scripts/backfill-orders.ts",
    "db:verify-orders": "tsx scripts/backfill-orders.ts",
    "db:verify-skus": "tsx scripts/migrate-skus.ts",
    "db:verify-images": "tsx scripts/backfill-product-images.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@google-cloud/storage": "^8.4.0",
    "@jeans-store/db": "*",
    "@jeans-store/shared": "*",
    "@jeans-store/validators": "*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "posthog-node": "^5.56.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@jeans-store/config": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
