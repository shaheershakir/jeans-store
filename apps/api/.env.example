# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database Persistence (Neon PostgreSQL)
# Local development & Test deployment (Neon 'test' branch for clothing-store):
# DATABASE_URL=postgresql://[user]:[password]@[test-endpoint].neon.tech/neondb?sslmode=require
# Production deployment (Neon 'main' branch for clothing-store):
# DATABASE_URL=postgresql://[user]:[password]@[production-endpoint].neon.tech/neondb?sslmode=require
# NOTE: Never expose DATABASE_URL to frontend or client-side bundles.
DATABASE_URL=

# Admin login (server-side only)
ADMIN_EMAIL=
ADMIN_NAME=Store administrator
ADMIN_PASSWORD=replace_with_a_long_unique_password
# Generate a separate random value of at least 32 characters for signing sessions.
ADMIN_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Stable secret for signing customer authentication tokens (32+ characters).
JWT_SECRET=replace_with_a_separate_random_secret_of_at_least_32_characters

# Product image uploads (Cloud Run uses its attached service account credentials)
GCP_PROJECT_ID=
GCS_PRODUCT_IMAGES_BUCKET=

# Frontend ISR Revalidation
# URL of storefront (e.g. https://storefront-xxx-uc.a.run.app)
FRONTEND_URL=http://localhost:3000
# Shared secret matching frontend's REVALIDATION_SECRET
REVALIDATION_SECRET=your_revalidation_secret_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PostHog Analytics (Server-side tracking)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

