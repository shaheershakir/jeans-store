# Copy this file to `.env` in the repository root and fill in your own values.
# `.env` is gitignored. Never commit real credentials.
# Docker Compose automatically reads this file for ${VAR} interpolation.

# --- Database -----------------------------------------------------------------
# For local dev container or remote database (e.g. Neon, Cloud SQL), set the full connection string:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Local Postgres container credentials (docker compose dev only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jeans_store

# --- API secrets & Authentication ---------------------------------------------
# Generate unique random values of 32+ characters for secrets. Do not reuse.
ADMIN_EMAIL=admin@teesgarage.in
ADMIN_NAME=Store Administrator
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_SECRET=replace_with_a_separate_random_secret_of_at_least_32_characters
REVALIDATION_SECRET=replace_with_a_random_revalidation_secret
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Razorpay) ------------------------------------------------------
# Key ID and Key Secret from Razorpay Dashboard (API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in Razorpay Webhooks settings
RAZORPAY_WEBHOOK_SECRET=

# --- Product Analytics (PostHog) ---------------------------------------------
# Server-side PostHog API key
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Client-side PostHog key for storefront
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# --- Object Storage -----------------------------------------------------------
# STORAGE_PROVIDER: local | gcs | s3
STORAGE_PROVIDER=local
ASSET_BASE_URL=http://localhost:4000/assets

# Google Cloud Storage (when STORAGE_PROVIDER=gcs)
GCP_PROJECT_ID=
GCS_PRODUCT_IMAGES_BUCKET=

# S3-compatible Object Storage (AWS S3, Cloudflare R2, MinIO; when STORAGE_PROVIDER=s3)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# --- Storefront Client Configuration -----------------------------------------
NEXT_PUBLIC_SITE_URL=https://teesgarage.in
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:4000/assets
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
