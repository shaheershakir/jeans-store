# Copy this file to `.env` in the repository root and fill in your own values.
# `.env` is gitignored. Never commit real credentials.
# Docker Compose automatically reads this file for ${VAR} interpolation.

# --- Database -----------------------------------------------------------------
# Optional. Unset falls back to the bundled local Postgres service:
#   postgresql://postgres:postgres@postgres:5432/jeans_store
# For a remote database (e.g. Neon), set the full connection string here.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Local Postgres container credentials (dev only; irrelevant for remote DBs).
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=jeans_store

# --- API secrets --------------------------------------------------------------
# Generate unique random values of 32+ characters for each. Do not reuse.
ADMIN_EMAIL=admin@localhost
ADMIN_NAME=Local Administrator
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_SECRET=replace_with_a_separate_random_secret_of_at_least_32_characters
REVALIDATION_SECRET=replace_with_a_random_revalidation_secret

# --- Payments -----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Object storage -----------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# --- Storefront build args ----------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:4000/assets
